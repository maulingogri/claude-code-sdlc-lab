# Twilio (Console > Account) — Stage 1 uses the WhatsApp Sandbox credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number is always whatsapp:+14155238886 unless Twilio changes it
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Existing Louisville Sangh WhatsApp group number, extra broadcast recipient
SANGH_GROUP_WHATSAPP_NUMBER=

# Set to true only for local dev without a real Twilio account / ngrok tunnel.
# Must be false (or unset) in staging and production.
SKIP_TWILIO_SIGNATURE_VALIDATION=false

DATABASE_URL=sqlite:///./paryushan.db

PARYUSHAN_START_DATE=2026-09-08
PARYUSHAN_END_DATE=2026-09-15
DEFAULT_TIMEZONE=America/New_York

# Shared admin dashboard login (added in a later build stage)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ADK agent (step 5): free-form routing for fasting/reflection/forgiveness
# logging, FAQ answers, and escalation, via Claude. Get a key at
# https://console.anthropic.com/settings/keys — leave blank to use the
# deterministic numbered menu instead (no agent, no LLM calls).
ANTHROPIC_API_KEY=
# Only needed if your key is identity-linked rather than workspace-scoped
# (Anthropic Console will tell you if so via a "workspace-id required" error)
ANTHROPIC_WORKSPACE_ID=
