# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# This agent uses Claude via LiteLLM, not Gemini — see brain/agent.py.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here
# Only needed if your key is identity-linked rather than workspace-scoped
ANTHROPIC_WORKSPACE_ID=

# brain/data.py talks directly to this SQLite file — kept separate from
# the root project's own paryushan.db so eval/test runs here don't write
# into real dev data. Initialize with: DATABASE_URL="sqlite:///$(pwd)/paryushan.db"
# (run from repo root) uv run python -m scripts.init_db
DATABASE_URL=sqlite:///./paryushan.db
